{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 104857600,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss zzz} [{Level:u3}] {SourceContext} {Properties:j} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "HR-AUTOMATION-API"
    }
  },
  "JwtConfigurations": {
    "Issuer": "hr-automation.auth",
    "DefaultAudience": "hr-automation.web",
    "AllowedAudiences": [ "hr-automation.web", "hr-automation.mobile", "hr-automation.worker" ],
    "ExpiresIn": 1800000,
    "ClockSkew": 300000,
    "NeverExpires": false
  },
  "RefreshTokenConfigurations": {
    "SecureTokenByteSize": 64,
    "RefreshTokenExpiresIn": 36000000
  }
}